[Unit]
Description=dMem memory daemon

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/dmem %h/.cache/dmem
ExecStartPre=/usr/bin/chmod 0700 %h/.local/share/dmem
ExecStart=/usr/bin/dmemd --config /usr/share/dmem/config.toml daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
StandardOutput=append:%h/.cache/dmem/dmem.log
StandardError=append:%h/.cache/dmem/dmem.log

[Install]
WantedBy=default.target
