{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmem.dev/schemas/agent-tool/v1/recall-output.json",
  "type": "object", "additionalProperties": false,
  "required": ["operation_id", "memories", "degraded_capabilities", "next_cursor"],
  "properties": {
    "operation_id": {"$ref": "#/$defs/id"},
    "memories": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/memory"}},
    "degraded_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["keyword", "graph", "semantic"]}},
    "next_cursor": {"type": ["string", "null"], "maxLength": 4096}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["memory_id", "revision_id", "kind", "content", "confidence", "evidence"],
      "properties": {
        "memory_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["fact", "event", "preference", "plan", "procedure", "scene", "topic", "timeline"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 4096},
        "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "event_id", "role"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"}, "event_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["direct", "derived", "temporal_anchor", "context"]},
        "event_time": {"type": "string", "format": "date-time"}, "event_sequence": {"type": "integer", "minimum": 0},
        "start_offset": {"type": "integer", "minimum": 0}, "end_offset": {"type": "integer", "minimum": 1}
      },
      "dependentRequired": {"start_offset": ["end_offset"], "end_offset": ["start_offset"]}
    }
  }
}
