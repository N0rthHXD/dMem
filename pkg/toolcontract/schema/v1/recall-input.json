{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmem.dev/schemas/agent-tool/v1/recall-input.json",
  "type": "object", "additionalProperties": false,
  "required": ["query", "scope_ids"],
  "properties": {
    "query": {"type": "string", "minLength": 1, "maxLength": 4096},
    "scope_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "intent": {"enum": ["auto", "lookup", "temporal", "entity", "relational", "multi_hop", "procedural", "exploratory", "verification"]},
    "entities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "reference_time": {"type": "string", "format": "date-time"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "cursor": {"type": "string", "maxLength": 4096}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
}
