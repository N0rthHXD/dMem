{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmem.dev/schemas/agent-tool/v1/feedback-output.json",
  "type": "object", "additionalProperties": false,
  "required": ["operation_id", "replayed", "feedback_id", "memory_id", "revision_id", "kind"],
  "properties": {
    "operation_id": {"$ref": "#/$defs/id"}, "replayed": {"type": "boolean"}, "feedback_id": {"$ref": "#/$defs/id"},
    "memory_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["used", "not_used", "incorrect", "outdated", "duplicate"]}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
}
