{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmem.dev/schemas/agent-tool/v1/memory-commit-input.json",
  "type": "object", "additionalProperties": false,
  "required": ["scope_id", "source", "memories"],
  "properties": {
    "scope_id": {"$ref": "#/$defs/id"},
    "source": {"$ref": "#/$defs/source"},
    "memories": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/memory"}},
    "entities": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/entity"}},
    "facts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/fact"}},
    "relations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "long_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "conversation_id", "turn_id", "occurred_at"],
      "properties": {
        "type": {"const": "agent_tool"}, "name": {"$ref": "#/$defs/long_id"}, "conversation_id": {"$ref": "#/$defs/long_id"},
        "turn_id": {"$ref": "#/$defs/long_id"}, "tool_call_id": {"$ref": "#/$defs/long_id"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "metadata": {"type": "object", "x-dmem-open-map": true, "maxProperties": 32}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["local_id", "kind", "content", "sensitivity", "confidence"],
      "properties": {
        "local_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["fact", "event", "preference", "plan", "procedure", "scene", "topic", "timeline"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 4096}, "sensitivity": {"enum": ["normal", "sensitive"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "search_hints": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["local_id", "type", "name", "confidence"],
      "properties": {
        "local_id": {"$ref": "#/$defs/id"}, "type": {"enum": ["person", "organization", "place", "project", "product", "event", "concept", "other"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256}, "aliases": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "entity_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["local_id"], "properties": {"local_id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["entity_id"], "properties": {"entity_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "fact_object": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["entity"], "properties": {"entity": {"$ref": "#/$defs/entity_ref"}}},
        {"type": "object", "additionalProperties": false, "required": ["string"], "properties": {"string": {"type": "string", "maxLength": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["number"], "properties": {"number": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["boolean"], "properties": {"boolean": {"type": "boolean"}}}
      ]
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["local_id", "subject", "predicate", "object", "evidence_memory", "confidence"],
      "properties": {
        "local_id": {"$ref": "#/$defs/id"}, "subject": {"$ref": "#/$defs/entity_ref"},
        "predicate": {"enum": ["same_as", "member_of", "has_member", "works_for", "employs", "reports_to", "manages", "leads", "located_at", "born_in", "owned_by", "owns", "prefers", "dislikes", "works_on", "created", "created_by", "participates_in", "has_participant", "plan_targets", "has_status", "is_active", "occurred_at", "occurred_during", "has_participant_count", "depends_on", "required_by", "derived_from"]},
        "object": {"$ref": "#/$defs/fact_object"}, "evidence_memory": {"$ref": "#/$defs/id"}, "confidence": {"$ref": "#/$defs/confidence"},
        "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "memory_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["local_id"], "properties": {"local_id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["memory_id", "revision_id"], "properties": {"memory_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["local_id", "type", "source", "target", "evidence_memory", "confidence"],
      "properties": {
        "local_id": {"$ref": "#/$defs/id"}, "type": {"enum": ["supports", "contradicts", "supersedes", "derived_from"]},
        "source": {"$ref": "#/$defs/memory_ref"}, "target": {"$ref": "#/$defs/memory_ref"},
        "evidence_memory": {"$ref": "#/$defs/id"}, "confidence": {"$ref": "#/$defs/confidence"}
      }
    }
  }
}
