{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmem.dev/schemas/agent-tool/v1/scope-output.json",
  "type": "object", "additionalProperties": false,
  "required": ["scope"],
  "properties": {"scope": {"$ref": "#/$defs/scope"}},
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_id", "parent_scope_id", "scope_type", "external_id", "display_name", "created_at"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/id"},
        "parent_scope_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "scope_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "external_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
